diff --git a/firmware/src/pad.c b/firmware/src/pad.c
index ee3ccad..fbfb674 100644
--- a/firmware/src/pad.c
+++ b/firmware/src/pad.c
@@ -20,6 +20,25 @@ static critical_section_t pad_lock;
